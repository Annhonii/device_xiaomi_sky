<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TopexText">
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textColor">@color/topex_text</item>
    </style>
    <style name="TopexText.Headline">
        <item name="android:textSize">30sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TopexText.Title">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TopexText.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TopexText.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/topex_mute</item>
    </style>
    <style name="TopexText.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/topex_mute</item>
    </style>
    <style name="TopexText.Section">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.067</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/topex_mute</item>
    </style>

    <!-- Use on activities instead of Theme.SubSettingsBase. Parent keeps SettingsLib preference plumbing. -->
    <style name="Theme.Topex" parent="Theme.SubSettingsBase">
        <item name="android:windowBackground">@color/topex_bg</item>
        <item name="android:colorBackground">@color/topex_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:textColorPrimary">@color/topex_text</item>
        <item name="android:textColorSecondary">@color/topex_mute</item>
        <item name="android:colorAccent">@color/topex_primary</item>
        <item name="android:colorControlActivated">@color/topex_primary</item>
        <item name="android:colorControlHighlight">@color/topex_high</item>
    </style>
</resources>
