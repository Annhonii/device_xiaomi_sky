<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:layout="@layout/topex_preference_category" android:title="@string/other_section_title">

        <SwitchPreference android:layout="@layout/topex_preference"
            android:key="mglru_enable"
            android:title="@string/mglru_enable_title"
            android:summary="@string/mglru_enable_summary"
            android:defaultValue="false" />

        <SwitchPreference android:layout="@layout/topex_preference"
            android:key="performance_mode_enable"
            android:title="@string/performance_enable_title"
            android:summary="@string/performance_enable_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <Preference android:layout="@layout/topex_preference"
        android:key="dynamic_island"
        android:title="@string/dynamic_island_title"
        android:summary="@string/dynamic_island_summary">
        <intent
            android:targetPackage="org.lineageos.settings"
            android:targetClass="com.agupta07505.smartisland.MainActivity" />
    </Preference>
</PreferenceScreen>