<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="40dp" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/topex_track" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:height="40dp" android:gravity="center_vertical">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/topex_primary" />
                <corners android:radius="100dp" />
            </shape>
        </clip>
    </item>
</layer-list>
