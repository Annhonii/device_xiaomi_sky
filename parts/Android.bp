android_app {
    name: "XiaomiParts",
    defaults: [
        "SettingsLibDefaults",
    ],

    init_rc: ["init.xiaomiparts.rc"],
    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.preference_preference",
        // ISLAND-COMPOSE: names follow prebuilts/sdk/current/androidx; fix any "module not found" here
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.core_core-ktx",
        "androidx.datastore_datastore-preferences",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-service",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "kotlinx_coroutines_android",
        "kotlinx_coroutines_core",
    ],

    kotlincflags: ["-Xjvm-default=all"],
    // ISLAND-COMPOSE: compose compiler plugin. Name differs per ROM; find it with:
    //   grep -rn "compose" prebuilts/sdk/current/androidx/Android.bp external/kotlinc/Android.bp | grep -i "compiler\|plugin"
    plugins: ["androidx.compose.compiler_compiler-hosted"],
    required: [
        "sysconfig-xiaomiparts-island.xml",
        "default-permissions-xiaomiparts-island.xml",
        "privapp-permissions-xiaomiparts-island.xml",
    ],
}

prebuilt_etc {
    name: "sysconfig-xiaomiparts-island.xml",
    src: "island/sysconfig-xiaomiparts-island.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default-permissions-xiaomiparts-island.xml",
    src: "island/default-permissions-xiaomiparts-island.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-xiaomiparts-island.xml",
    src: "island/privapp-permissions-xiaomiparts-island.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
